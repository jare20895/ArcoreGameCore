{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArcoreGameCore Asset Manifest",
  "type": "object",
  "required": ["game", "assets"],
  "properties": {
    "game":    { "type": "string" },
    "assets":  { "type": "array", "items": { "$ref": "#/definitions/Asset" } }
  },
  "definitions": {
    "Asset": {
      "type": "object",
      "required": ["id", "type", "source_format", "status"],
      "properties": {
        "id":              { "type": "string", "description": "Unique key matching Phaser load key" },
        "type":            { "type": "string", "enum": ["sprite", "spritesheet", "audio_bgm", "audio_sfx", "tileset", "font", "ui", "particle", "portrait"] },
        "label":           { "type": "string" },
        "source_format":   { "type": "string", "description": "e.g. svg-inline, png, mp3, ogg, json-atlas" },
        "source_ref":      { "type": "string", "description": "File path or defining function in source code" },
        "godot_path":      { "type": ["string", "null"], "description": "res:// import path in Godot project" },
        "godot_type":      { "type": ["string", "null"], "description": "e.g. Texture2D, SpriteFrames, AudioStreamOggVorbis" },
        "used_by":         { "type": "array", "items": { "type": "string" }, "description": "Component IDs that use this asset" },
        "status":          { "type": "string", "enum": ["pending", "exported", "imported", "done", "skip"] },
        "notes":           { "type": "string" }
      }
    }
  }
}
