; Engine configuration file.
; Generated for ArcoreGameCore framework template.

[application]

config/name="ArcoreGameCore"
config/description="Arcore reusable Godot 4 game framework (C#)"
config/features=PackedStringArray("4.3", "C#", "Mobile")
config/icon="res://icon.svg"
run/main_scene="res://scenes/boot/Boot.tscn"

[autoload]

GameState="*res://autoload/GameState.cs"
SaveManager="*res://autoload/SaveManager.cs"
AudioManager="*res://autoload/AudioManager.cs"
InputManager="*res://autoload/InputManager.cs"
PlatformBridge="*res://autoload/PlatformBridge.cs"
SceneRouter="*res://autoload/SceneRouter.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/arcore_game_core/plugin.cfg")

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"

[android]

package/unique_name="com.arcore.{game_id}"
package/name="{AppName}"
version/name="1.0.0"
version/code=1

[export]

; Export preset file: export_presets.cfg (see docs/EXPORT_SETUP.md)
